# Configuration du serveur Voyaj CRM — copiez ce fichier en `.env`.
# Les variables d'environnement du système ont priorité sur ce fichier.

# Adresse d'écoute. Hors localhost, le TLS est obligatoire : soit
# VOYAJ_TLS_CERT/VOYAJ_TLS_KEY, soit un reverse proxy HTTPS (VOYAJ_TRUST_PROXY).
VOYAJ_HOST=127.0.0.1
VOYAJ_PORT=8080
# VOYAJ_TRUST_PROXY=false
# VOYAJ_TLS_CERT=C:\ProgramData\Voyaj\tls\cert.pem
# VOYAJ_TLS_KEY=C:\ProgramData\Voyaj\tls\key.pem

# Base PostgreSQL (ajoutez ?sslmode=require pour une base distante).
DATABASE_URL=postgres://voyaj:motdepasse@localhost:5432/voyaj
# VOYAJ_DB_POOL_SIZE=10

# Base utilisée par les tests d'intégration (ENTIÈREMENT VIDÉE à chaque test).
TEST_DATABASE_URL=postgres://voyaj:motdepasse@localhost:5432/voyaj_test

# Clé maître AES-256 (base64, 32 octets) chiffrant les secrets au repos.
# Générez-la avec : voyaj_server gen-key — et sauvegardez-la en lieu sûr :
# sans elle, les secrets chiffrés (2FA…) sont irrécupérables.
VOYAJ_MASTER_KEY=

# Journalisation : FINE, INFO, WARNING, SEVERE.
VOYAJ_LOG_LEVEL=INFO

# Durées des jetons.
# VOYAJ_ACCESS_TOKEN_TTL_MINUTES=15
# VOYAJ_REFRESH_TOKEN_TTL_DAYS=30

# Migrations appliquées automatiquement au démarrage.
# VOYAJ_AUTO_MIGRATE=true

# Coût du hachage Argon2id des mots de passe.
# VOYAJ_ARGON2_MEMORY_KIB=19456
# VOYAJ_ARGON2_ITERATIONS=2
