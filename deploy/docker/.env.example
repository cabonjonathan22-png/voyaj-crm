# Variables du déploiement Docker — copiez ce fichier en `.env`.

# Nom de domaine public pointant vers ce serveur (DNS A/AAAA).
VOYAJ_DOMAIN=crm.exemple.fr

# Mot de passe PostgreSQL (lettres et chiffres uniquement : il est inséré
# dans une URL de connexion).
POSTGRES_PASSWORD=

# Clé maître (base64, 32 octets). Générez-la avec :
#   openssl rand -base64 32
# Conservez-la précieusement : sans elle, les secrets chiffrés sont perdus.
VOYAJ_MASTER_KEY=

VOYAJ_LOG_LEVEL=INFO
